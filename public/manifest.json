{
  "manifest_version": 3,
  "name": "Pico API - HTTP & REST Client",
  "short_name": "Pico",
  "version": "1.0.5",
  "version_name": "1.0.5",
  "description": "Lightweight HTTP client & REST API testing tool for Chrome. Send requests, debug APIs, and stream responses without leaving the tab.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open Pico API",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["cookies"],
  "host_permissions": ["<all_urls>"],
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}